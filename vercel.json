{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/chat.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 120
    },
    "api/selection.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 60
    },
    "api/tts.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 30
    },
    "api/files.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 60
    },
    "api/memories/index.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 15
    },
    "api/memories/[id].ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 15
    },
    "api/reminders/index.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 15
    },
    "api/reminders/[id].ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 15
    },
    "api/weather.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 30
    },
    "api/daily-briefing.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 20
    },
    "api/subscription.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 15
    },
    "api/account/delete.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 60
    },
    "api/health.ts": {
      "includeFiles": "lib/server/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/translation",
      "destination": "/api/selection"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
