{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/chat.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 60
    },
    "api/memory-test.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 15
    },
    "api/vision.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 15
    },
    "api/memories/index.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 15
    },
    "api/memories/[id].ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
