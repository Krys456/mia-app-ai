# Local: copy to `.env.local` (Vite) and/or use `vercel env` / `.env` for `vercel dev`.
# Vercel Dashboard → Project → Settings → Environment Variables

# --- Server only (Vercel Serverless) — NEVER prefix with VITE_ ---
OPENAI_API_KEY=
# Optional model override (default: gpt-4o). Use letter o, not digit zero.
# OPENAI_MODEL=gpt-4o

# Live chat uses the new single-prompt core (runtime: core).
# Legacy V1/V2 dispatcher under lib/server/conversation-runtime/ is unused by /api/chat.

# --- #298A Security & abuse protection ---
# Durable rate limiting (Upstash Redis REST). REQUIRED on Vercel production/preview.
# Without these, paid APIs fail closed (503) — never unlimited OpenAI.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Local/dev ONLY (never set on Vercel): allow ephemeral in-memory limiter for offline tests.
# RATE_LIMIT_DEV_INMEMORY=1
#
# Optional comma-separated extra CORS origins (production app URL, custom domains).
# Localhost + this project's *.vercel.app previews are allowed by default.
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com
#
# Paid APIs (/api/chat, /api/selection, /api/tts, /api/files) require:
#   Authorization: Bearer <Supabase access token>
# Verified server-side via auth.getUser(token). Client userId headers are ignored.

# --- Phase 0 / Phase 1A memory access ---
# /api/memories and /api/memories/[id] require Authorization: Bearer <Supabase access token>
# (verified auth.uid() is the ownership authority — not X-LAIfe-User-Id / body.userId).
#
# /api/memory-test: DISABLED when VERCEL_ENV=production (returns 404).
# Non-production still uses Phase 0 admin secret (developer curl only; never VITE_*):
# LAIFE_MEMORY_ADMIN_SECRET=replace-with-a-long-random-string
#
# Developer memory-test (preview/local only):
#   curl -sS -X POST "$ORIGIN/api/memory-test" \
#     -H "Content-Type: application/json" \
#     -H "X-LAIfe-Memory-Secret: $LAIFE_MEMORY_ADMIN_SECRET" \
#     -d '{"userMessage":"Mi chiamo Luca","assistantMessage":"Ciao Luca"}'
#
# Authenticated memories list (token from browser anonymous session):
#   curl -sS -X GET "$ORIGIN/api/memories" \
#     -H "Accept: application/json" \
#     -H "Authorization: Bearer $SUPABASE_ACCESS_TOKEN"
#     → 401 without a valid Bearer token

# --- Client (Vite — must use VITE_ prefix) ---
# Leave empty on Vercel so the app calls same-origin `/api/*`
# VITE_API_BASE_URL=
# Local vite → proxy /api to `vercel dev` (default http://127.0.0.1:3000)
# VITE_DEV_API_PROXY=http://127.0.0.1:3000

# Supabase browser client (anon key is safe for browser use with RLS)
# Source of truth helper: src/lib/supabase.ts
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Phase 1A — Anonymous Auth bootstrap (client):
# Enable in Supabase Dashboard → Authentication → Sign In / Providers → Anonymous Sign-Ins → Enable
# Without this, silent signInAnonymously() fails; paid APIs cannot proceed.
#
# #332E2 — Durable identity (email link MVP; no billing):
# Email provider must be enabled; add Preview/Production URLs to Auth redirect allowlist.
# Optional Google linking (requires Manual Linking + Google provider first):
# VITE_AUTH_GOOGLE_LINKING_ENABLED=false

# --- #298B Privacy & Data / #298C Observability (client-safe) ---
# Closed-beta contact shown in Settings → Privacy & Data (names only; no secrets).
# Also used for mailto "Segnala un problema".
# VITE_PRIVACY_CONTACT_EMAIL=you@example.com
#
# Optional: set to 0 to hide Memory Manage UI (default = enabled in all environments).
# VITE_MEMORY_MANAGE_UI=0
#
# #303A Reminders — default enabled. Set to 0 to hide UI / kill client surface.
# Server kill switch (API 404): REMINDERS_ENABLED=0
# VITE_REMINDERS_ENABLED=0
# REMINDERS_ENABLED=0
#
# #303C Web Push — optional. Delivery is server/Edge gated; never put private VAPID in VITE_*.
# VITE_VAPID_PUBLIC_KEY=   # URL-safe applicationServerKey from negrel exportApplicationServerKey
# VITE_PUSH_ENABLED=0      # optional UI kill switch (default: UI on when public key present)
# PUSH_ENABLED=false         # Edge/server delivery kill switch (default off)
# VAPID_KEYS_JSON=           # Edge only — full JWK JSON from negrel generate-vapid-keys (NEVER VITE_)
# VAPID_SUBJECT=mailto:you@example.com
# REMINDER_PUSH_WORKER_SECRET=
# REMINDER_PUSH_ALLOW_ENV=production
#
# #304A1 Google Calendar OAuth — connection foundation (Settings ON/OFF).
# #304A2 Google Calendar READ service — Node lib/server only (NOT wired into /api/chat yet; that is #304A3).
# Settings → Integrazioni → Google Calendar is ALWAYS visible in the client.
# Server/Edge/Node CALENDAR_ENABLED is the real activation gate (default off).
# Do not enable CALENDAR_ENABLED in Production until operator acceptance + migration applied.
# CALENDAR_ENABLED=false           # Edge + Node kill switch (default off) — NOT a VITE_ var
# GOOGLE_OAUTH_CLIENT_ID=          # Edge + Node (token refresh) — never VITE_
# GOOGLE_OAUTH_CLIENT_SECRET=      # Edge + Node (token refresh) — never VITE_
# CALENDAR_TOKEN_ENCRYPTION_KEY=   # Edge + Node — 32-byte key as base64 or 64-char hex (NEVER VITE_)
# CALENDAR_OAUTH_REDIRECT_URI=     # Edge only — must match Google Cloud authorized redirect
#                                  # e.g. https://<project>.supabase.co/functions/v1/calendar-oauth-callback
# CALENDAR_RETURN_URL=             # Edge only — app origin allowlist base, e.g. https://your-app.vercel.app
# For #304A2 Node reads (future /api/chat import), Vercel also needs the same:
#   CALENDAR_ENABLED, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET,
#   CALENDAR_TOKEN_ENCRYPTION_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# Operator smoke (local only, never a Vercel route):
#   CALENDAR_SMOKE_USER_ID=<supabase auth.uid()> node scripts/calendar-read-smoke.mjs
#
# Short build id is injected automatically from VERCEL_GIT_COMMIT_SHA at Vite build.
# Optional local override (names only; never put secrets here):
# VITE_BUILD_ID=devlocal
#
# Supabase RLS owner policies: see
# supabase/migrations/20260817210000_rls_owner_policies_298b.sql
# Apply manually after review — do not auto-run against live DB from CI.

# --- #317 Weather / Meteo (Open-Meteo) ---
# Free Forecast + Geocoding APIs — NO API key, NO billing, NO Google Places dependency.
# Attribution (show in Weather UI): "Weather data: Open-Meteo"
# Commercial / high-volume use may require an Open-Meteo commercial arrangement later.
# Endpoint: POST /api/weather (auth + rate-limit bucket `weather` ~30/min/user)
# Diagnostics: ?weather_diag=1 (never logs precise GPS or raw provider payloads)

# Supabase server (required for /api/memories* and memory pipeline)
# Source of truth helper: lib/server/supabase.js → getServiceSupabase()
# SUPABASE_URL preferred; VITE_SUPABASE_URL is accepted as URL fallback only.
# SUPABASE_SERVICE_ROLE_KEY is required (never use the anon key for server writes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
