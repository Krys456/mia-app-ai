# Local: copy to `.env.local` (Vite) and/or use `vercel env` / `.env` for `vercel dev`.
# Vercel Dashboard → Project → Settings → Environment Variables

# --- Server only (Vercel Serverless) — NEVER prefix with VITE_ ---
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Postgres connection string for Memory (Neon / Vercel Postgres / any Postgres)
DATABASE_URL=

# --- Client (Vite — must use VITE_ prefix) ---
# Leave empty on Vercel so the app calls same-origin `/api/*`
# VITE_API_BASE_URL=

# Supabase (BrAIn Memory foundation — anon key is safe for client use with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server (Vercel serverless — preferred for /api/memories)
# SUPABASE_URL can fall back to VITE_SUPABASE_URL if unset
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

