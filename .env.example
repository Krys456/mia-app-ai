# Local: copy to `.env.local` (Vite) and/or use `vercel env` / `.env` for `vercel dev`.
# Vercel Dashboard → Project → Settings → Environment Variables

# --- Server only (Vercel Serverless) — NEVER prefix with VITE_ ---
OPENAI_API_KEY=
# Optional model override (default: gpt-4o). Use letter o, not digit zero.
# OPENAI_MODEL=gpt-4o

# Live chat uses the new single-prompt core (runtime: core).
# Legacy V1/V2 dispatcher under lib/server/conversation-runtime/ is unused by /api/chat.

# --- Phase 0: Memory admin lockdown (server-only; NEVER use VITE_ prefix) ---
# Required to call /api/memories* or /api/memory-test. Without it, those routes fail closed.
# LAIFE_MEMORY_ADMIN_SECRET=replace-with-a-long-random-string
#
# Developer test (do not put this secret in the frontend):
#   curl -sS -X GET "$ORIGIN/api/memories" \
#     -H "Accept: application/json" \
#     -H "X-LAIfe-Memory-Secret: $LAIFE_MEMORY_ADMIN_SECRET"
#   curl -sS -X GET "$ORIGIN/api/memories" -H "Accept: application/json"
#     → 401 Unauthorized (or 503 if the env var is unset)

# --- Client (Vite — must use VITE_ prefix) ---
# Leave empty on Vercel so the app calls same-origin `/api/*`
# VITE_API_BASE_URL=
# Local vite → proxy /api to `vercel dev` (default http://127.0.0.1:3000)
# VITE_DEV_API_PROXY=http://127.0.0.1:3000

# Supabase browser client (anon key is safe for browser use with RLS)
# Source of truth helper: src/lib/supabase.ts
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Phase 1A — Anonymous Auth bootstrap (client):
# Enable in Supabase Dashboard → Authentication → Sign In / Providers → Anonymous Sign-Ins → Enable
# Without this, silent signInAnonymously() fails soft; chat still works.

# Supabase server (required for /api/memories* and memory pipeline)
# Source of truth helper: lib/server/supabase.js → getServiceSupabase()
# SUPABASE_URL preferred; VITE_SUPABASE_URL is accepted as URL fallback only.
# SUPABASE_SERVICE_ROLE_KEY is required (never use the anon key for server writes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
